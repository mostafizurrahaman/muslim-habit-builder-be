# =============================================================================
# Muslim Habit Builder Backend - Environment Variables
# Copy this file to `.env` and replace placeholder values with your own.
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=5000
SERVER_NAME=Muslim Habit Builder API
SERVER_URL=http://localhost:5000
BASE_URL=localhost
FRONTEND_URL=http://localhost:3000

# --- Database ---
MONGODB_URL=mongodb://localhost:27017/muslim-habit-builder

# --- Security ---
SALT_ROUNDS=10
HASH_SECRET_KEY=your-hash-secret-key-change-me
JWT_ACCESS_TOKEN_SECRET=your-jwt-access-secret-change-me
JWT_REFRESH_TOKEN_SECRET=your-jwt-refresh-secret-change-me
JWT_ACCESS_TOKEN_EXPIRESIN=1d
JWT_REFRESH_TOKEN_EXPIRESIN=7d
OTP_TOKEN_EXPIRESIN=2m
OTP_EXPIRY_MINUTES=5

# --- Google OAuth (Sign in with Google) ---
GOOGLE_CLIENT_ID_WEB=your-google-client-id-web
GOOGLE_CLIENT_ID_ANDROID=your-google-client-id-android
GOOGLE_CLIENT_ID_IOS=your-google-client-id-ios

# --- Stripe (payments) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# --- Email (Gmail SMTP via Nodemailer) ---
GMAIL_APP_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# --- Admin seed user (created on first server start) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456

# --- App / callback secrets (required by config) ---
APP_ID=your-app-id
SERVER_SECRET=your-server-secret
CALLBACK_SECRET=your-callback-secret

# --- Cloudinary (image & file uploads) ---
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
